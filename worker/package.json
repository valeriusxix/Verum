{
  "name": "@verum/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Indexer (backfill + incremental sync), metrics rollups, daily snapshot attester, registry event listener.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=../.env src/cli/migrate.ts",
    "track": "tsx --env-file-if-exists=../.env src/cli/track.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@verum/shared": "workspace:*",
    "postgres": "^4.1.1",
    "viem": "^2.57.20",
    "zod": "^4.6.7"
  }
}
