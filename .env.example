# Copy to .env (never commit .env). Read by worker + api (tsx --env-file) and web (Vite, VITE_* only).

# ---- network ---------------------------------------------------------------
# mainnet = QIE 1990 · testnet = QIE 1983 (dev only)
VERUM_NETWORK=mainnet

# ---- database (worker + api) ------------------------------------------------
# Supabase: Dashboard -> Connect -> "Session pooler" (port 5432, IPv4). The direct connection
# is IPv6-only, and the Transaction pooler (6543) can't hold prepared statements.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# TLS is always required. Supabase's pooler cert is signed by Supabase's own CA, so for full
# certificate verification download it (Dashboard -> Database Settings -> SSL Configuration)
# and set its path here. Empty = encrypted, certificate not verified.
# NOTE: the verify path is not yet tested against Supabase (as of 20 Nov). If the connection
# fails after setting it, clear this value and report it.
DATABASE_CA_CERT=
# worker log level: debug | info | warn | error (info logs every explorer request)
LOG_LEVEL=info

# ---- registry contract -----------------------------------------------------
# Defaults come from packages/shared/deployments.ts; set only to override.
#   testnet (1983): 0xF5B151fCcf3C4b79345643f634f29A584d461390
#   mainnet (1990): TBD (Day 9)
REGISTRY_ADDRESS=

# ---- attester (worker) -----------------------------------------------------
# Verum backend key: calls snapshot() / markMilestone(). Needs a little mainnet QIE for gas.
ATTESTER_PK=
# Public address of ATTESTER_PK: constructor arg for contracts/script/DeployVerumRegistry.s.sol
# (testnet attester: 0xcA2088DdEF3d868e56905957600950a840FeCCC0; mainnet gets its own key)
ATTESTER_ADDRESS=
# Alert when the attester balance drops below this (in QIE). Set a value once gas costs are measured.
ATTESTER_MIN_BALANCE_QIE=

# ---- api -------------------------------------------------------------------
PORT=8787

# ---- web (exposed to the browser: public values only) ----------------------
VITE_API_URL=http://localhost:8787
VITE_REGISTRY_ADDRESS=
